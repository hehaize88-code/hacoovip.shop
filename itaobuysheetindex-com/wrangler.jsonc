{
  "keep_names": false,
  "name": "itaobuysheetindex-com",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-01",
  "build": { "command": "node build.mjs" },
  "routes": [
    { "pattern": "itaobuysheetindex.com", "custom_domain": true },
    { "pattern": "www.itaobuysheetindex.com", "custom_domain": true }
  ]
}
