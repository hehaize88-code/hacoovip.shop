{
  "name": "ootdbuysheetindex-com",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-20",
  "build": {
    "command": "npm run build"
  },
  "routes": [
    {
      "pattern": "ootdbuysheetindex.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ootdbuysheetindex.com",
      "custom_domain": true
    }
  ]
}
