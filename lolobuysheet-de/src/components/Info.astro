---
import Layout from '../layouts/Layout.astro';import Search from './Search.astro';
import {href,ui,articleSlugs,type Locale} from '../lib/i18n';import {article,officialSources} from '../lib/content';import {faqs} from '../lib/faq';
interface Props {lang:Locale;section:string;slug?:string;}
const {lang,section,slug}=Astro.props;const t=ui[lang];const a=article(lang,slug||section);const title=a.title||t[section==='image-search'?'imageSearch':section];const page=slug?`articles/${slug}`:section;
---
<Layout lang={lang} title={`${title} | LoloBuy Sheet`} description={a.paragraphs[0]?.slice(0,165)||t.intro} page={page} noindex={['privacy','image-search'].includes(section)}>
<div class="shell prose-layout"><nav class="prose-nav" aria-label={t.menu}>{['guide','qc','shipping','faq','articles'].map(key=><a href={href(lang,key)} aria-current={section===key?'page':undefined}>{t[key]}</a>)}<a href={href(lang,'spreadsheet')}>{t.catalog} ↗</a></nav>
<article class="prose"><p class="eyebrow">LOLOBUY SHEET / {t.editorial}</p><h1>{title}</h1>
{a.paragraphs.map(p=><p>{p}</p>)}
{section==='faq'&&<div class="faq-list">{faqs(lang).map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div>}
{section==='articles'&&!slug&&<><p>{t.articleIntro}</p><div class="article-grid">{articleSlugs.map((s,i)=><a class="article-card" href={href(lang,`articles/${s}`)}><span class="article-number">0{i+1}</span><h3>{article(lang,s).title}</h3><span>{t.read} ↗</span></a>)}</div></>}
{section==='image-search'&&<><div class="notice"><p>{t.imageUnavailable}</p></div><Search lang={lang}/><p class="fine-print"><a href={href(lang,'categories')}>{t.categories} ↗</a></p></>}
{officialSources[section]&&<div class="source-link"><p>{t.sourceTitle}: <a href={officialSources[section]} target="_blank" rel="noopener noreferrer">LoloBuy Help Center ↗</a></p><p class="checked"><time datetime="2026-10-19">{t.checked}</time></p></div>}
{slug&&<p class="fine-print"><a href={href(lang,'articles')}>← {t.articles}</a></p>}
</article></div>
</Layout>
