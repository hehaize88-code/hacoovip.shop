---
import { locales, names, href, ui, type Locale } from '../lib/i18n';
import { REGISTER_URL } from '../lib/source';
import '../styles/global.css';
import '../styles/mobile.css';
interface Props { lang: Locale; title: string; description: string; page?: string; noindex?: boolean; }
const {lang,title,description,page='',noindex=false}=Astro.props;
const t=ui[lang];
const site=Astro.site || new URL('https://lolobuysheet.de');
const isPreview=import.meta.env.PUBLIC_SITE_PREVIEW === 'true';
const canonical=new URL(href(lang,page),site).href;
const nav=[['catalog','spreadsheet'],['articles','articles'],['categories','categories'],['guide','guide'],['qc','qc'],['shipping','shipping'],['faq','faq']];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
{!isPreview && <script is:inline>
(() => {
  // Keep local builds and preview hosts out of the production property.
  if (!['lolobuysheet.de', 'www.lolobuysheet.de'].includes(window.location.hostname)) return;
  window.dataLayer = window.dataLayer || [];
  function gtag(){ window.dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', 'G-LXR4CPTJ8E', {
    allow_google_signals: false,
    allow_ad_personalization_signals: false
  });
  const tag = document.createElement('script');
  tag.async = true;
  tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-LXR4CPTJ8E';
  document.head.appendChild(tag);
  // Measure distinct journey steps without a second page_view or search/order data.
  document.addEventListener('click', event => {
    const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
    if (!link || link.hasAttribute('data-locale-link')) return;
    const target = new URL(link.href, location.href);
    const internal = target.origin === location.origin;
    let name = link.dataset.track;
    if (!name && internal && /\/spreadsheet\/$/.test(target.pathname)) name = 'catalog_open';
    if (!name && internal && /\/product\/\d+\/$/.test(target.pathname)) name = 'product_open';
    if (!['buy_click','register_click','catalog_open','product_open'].includes(name)) return;
    gtag('event', name, {
      content_language: document.documentElement.lang,
      page_type: location.pathname.includes('/articles/') ? 'article' : /\/product\//.test(location.pathname) ? 'product' : 'browse',
      link_area: link.closest('header') ? 'header' : link.closest('footer') ? 'footer' : 'content',
      transport_type: 'beacon'
    });
  });
})();
</script>}
<title>{title}</title><meta name="description" content={description} />
<link rel="icon" type="image/png" href="/favicon.png" /><link rel="apple-touch-icon" href="/favicon.png" />
<link rel="canonical" href={canonical} />
{locales.map(l=><link rel="alternate" hreflang={l} href={new URL(href(l,page),site).href} />)}
<link rel="alternate" hreflang="x-default" href={new URL(href('de',page),site).href} />
<meta name="robots" content={isPreview?'noindex,nofollow':noindex?'noindex,follow':'index,follow'} /><meta name="theme-color" content="#fffaf4" />
<meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="LoloBuy Sheet" />
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'LoloBuy Sheet',url:site.href,inLanguage:locales}).replace(/</g,'\\u003c')} />
</head>
<body>
<a class="skip" href="#main">{t.skip}</a>
<header class="site-header"><div class="header-inner">
<a class="brand" href={href(lang)} aria-label="LoloBuy Sheet"><span class="logo-wrap"><img src="/logo.svg" width="128" height="30" alt="LoloBuy" /></span><span class="brand-caption">SHEET</span></a>
<nav aria-label={t.menu}>{nav.map(([key,p])=><a class:list={{'article-nav-link':key==='articles'}} href={href(lang,p)} aria-current={page===p||page.startsWith(`${p}/`)?'page':undefined}>{t[key]}</a>)}</nav>
<div class="header-actions"><details class="language"><summary aria-label={t.language}><span aria-hidden="true">◎</span> {lang.toUpperCase()} <span aria-hidden="true">⌄</span></summary><div class="language-menu">{locales.map(l=><a data-locale-link href={href(l,page)} lang={l} hreflang={l} aria-current={lang===l?'true':undefined}>{names[l]}<span>{l.toUpperCase()}</span></a>)}</div></details><a class="register" data-track="register_click" href={REGISTER_URL} rel="nofollow noopener noreferrer" target="_blank">{t.register}</a></div>
</div></header>
<main id="main"><slot /></main>
<footer><div class="footer-inner"><div><a class="footer-name" href={href(lang)}>LoloBuy <b>Sheet.</b></a><p>{t.independent}</p></div><div class="footer-links"><a href={href(lang,'about')}>{t.about}</a><a href={href(lang,'privacy')}>{t.privacy}</a><a href="/sitemap.xml">Sitemap</a><span>© {new Date().getFullYear()} lolobuysheet.de</span></div></div></footer>
<script>
// Only reset when crossing the breakpoint, so a reader's manual toggle persists.
const compactViewport=window.matchMedia('(max-width: 700px)');
const syncDisclosures=()=>{
 for(const panel of document.querySelectorAll<HTMLDetailsElement>('[data-mobile-collapse]')) panel.open=!compactViewport.matches;
};
syncDisclosures();
compactViewport.addEventListener('change',syncDisclosures);
for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-locale-link]')) link.search=window.location.search;
for(const img of document.querySelectorAll<HTMLImageElement>('[data-product-image]')) {
  const fail=()=>{ img.hidden=true; img.parentElement?.querySelector<HTMLElement>('.image-fallback')?.removeAttribute('hidden'); };
  img.addEventListener('error',fail); if(img.complete && !img.naturalWidth) fail();
}
document.addEventListener('click',event=>{
 const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-gallery]');
 if(button){const main=document.querySelector<HTMLImageElement>('#gallery-main');if(main){main.src=button.dataset.gallery!;main.hidden=false;main.parentElement?.querySelector('.image-fallback')?.setAttribute('hidden','');document.querySelectorAll('[data-gallery]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}}
});
</script>
</body></html>
